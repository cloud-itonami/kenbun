;; Deploy shell for cloud-itonami/kenbun (ADR-2608170100).
;; Library sources come from the west checkouts as shadow source-paths, the
;; same pattern kotoba-lang/kotobase-protocols-worker uses, relative to
;; orgs/cloud-itonami/kenbun/worker.
;; Build: npx shadow-cljs release worker -> out/worker.js (:esm), run through
;; scripts/resource-guard.mjs in the superproject (repo-wide build governor).
{:source-paths
 ["src"
  "../src"                                  ; kenbun.{finding,evidence,dedupe,triage,credit,intake,http}
  "../../../kotoba-lang/kotoba-issue/src"   ; kotoba.issue.{store,gate,run}
  "../../../kotoba-lang/kotobase-client/src"] ; kotobase.{client,cacao,cid} — the
                                              ; kotobase.net datom-plane client

 :dependencies []

 :builds
 {:worker {:target :esm
           :output-dir "out"
           ;; Serialize compilation: parallel par-compile aborts under host
           ;; CPU contention from the concurrent agent builds this machine
           ;; runs (the same note kotobase-protocols-worker carries).
           :compiler-options {:parallel-build false}
           :modules {:worker {:exports {default kenbun.worker/handler
                                        KenbunStore kenbun.worker/KenbunStore}}}}
  ;; A one-off script that asks the REAL kotobase.net what its datom plane
  ;; does with a repeated attribute. The answer decides whether the store
  ;; adapter must retract before asserting (the embedded engine accumulates),
  ;; and it is not a question that can be answered by reading source.
  :probe {:target :node-script
          :output-to "out/probe.js"
          :compiler-options {:parallel-build false}
          :main kenbun.probe/main}
  ;; End-to-end check of the kotobase.net store against the live service.
  ;; Ephemeral identity, throwaway database — see the namespace docstring.
  :e2e {:target :node-script
        :output-to "out/e2e.js"
        :compiler-options {:parallel-build false}
        :main kenbun.e2e/main}
  :inspect {:target :node-script
            :output-to "out/inspect.js"
            :compiler-options {:parallel-build false}
            :main kenbun.inspect/main}}}
