{
  // cloud-itonami/kenbun — admission gate for human/agent bug findings.
  //
  // kenbun.itonami.cloud was claimed deliberately on 2026-08-17, after
  // checking it was unheld: no DNS record, and no other wrangler config in
  // the workspace names it. Custom domains are single-owner and the last
  // `wrangler deploy` declaring one wins with NO conflict surfaced to either
  // side — kotoba-lang/kotobase-protocols-worker lost git.kotobase.net that
  // way on 2026-07-17 — so the check happens before the claim, and the claim
  // is never a side effect of shipping something else.
  "name": "kenbun",
  "main": "out/worker.js",
  "compatibility_date": "2025-03-17",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    { "pattern": "kenbun.itonami.cloud", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kenbun",
      "database_id": "54acbbff-20af-43cb-b7e2-bbd3f25c5fc9"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "KENBUN_STORE", "class_name": "KenbunStore" }
    ]
  },
  // new_sqlite_classes, not new_classes: this account no longer accepts
  // key-value backed Durable Object namespaces (API error 10099). The object
  // holds no state of its own either way — it exists to serialize, and the
  // rows live in D1.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["KenbunStore"] }
  ]
}
