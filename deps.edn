;; cloud-itonami/kenbun — 検分. Admission decisions for human/agent bug
;; findings (ADR-2608170100).
;;
;; :deps uses :git/sha so this repo is forkable standalone; the workspace
;; checkout overrides to the sibling with :dev (the same split every other
;; cloud-itonami repo uses).
{:paths ["src"]

 :deps {
        ;; kotoba.lang.edn replaced clojure.edn here (2026-09-23). An explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, and kbb resolves git deps
        ;; only from nbb.edn, so every project file this repo has names it.
        io.github.kotoba-lang/edn
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "7e1dbe0aece831138e6106c59d2b26375d0f60c4"
         :deps/root "lib/kotoba.edn"}
       ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "7e1dbe0aece831138e6106c59d2b26375d0f60c4"
         :deps/root "lib/kotoba.test"}
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "7e1dbe0aece831138e6106c59d2b26375d0f60c4"
         :deps/root "lib/kotoba.text"}
       org.clojure/clojure {:mvn/version "1.12.0"}
        io.github.kotoba-lang/kotoba-issue
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "7e1dbe0aece831138e6106c59d2b26375d0f60c4"
         :deps/root "lib/kotoba.kotobaIssue"}}

 :aliases
 {:dev {:override-deps
        {io.github.kotoba-lang/kotoba-issue
        {:local/root "../../kotoba-lang/kotoba/lib/kotoba.kotobaIssue"}
         io.github.kotoba-lang/kotobase
         {:local/root "../../kotoba-lang/kotobase"}
         io.github.kotoba-lang/kotobase-engine
         {:local/root "../../kotoba-lang/kotobase-engine"}
         io.github.kotoba-lang/kotobase-storage
        {:local/root "../../kotoba-lang/kotoba/lib/kotoba.kotobaseStorage"}}}

  ;; Opt-in durable store. Kept off the default :paths so the base library's
  ;; dependency surface stays at kotoba-issue alone — a caller happy with
  ;; store/mem-store should not pull the datom plane. JVM only: kotobase.core
  ;; returns Promises on ClojureScript and IssueStore is synchronous.
  :kotobase {:extra-paths ["src-kotobase"]
             :extra-deps {io.github.kotoba-lang/kotobase
                          {:git/url "https://github.com/kotoba-lang/kotobase.git"
                           :git/sha "bb29834f5f95ac88bf447f03cf0d440bcfce6d05"}}}

  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}

  ;; A real durable provider. Without it "provider-neutral" is a claim only
  ;; ever checked against an in-memory store, which cannot fail to survive a
  ;; restart because there is no restart.
  :kotobase-sqlite {:extra-deps {io.github.kotoba-lang/kotobase-storage-sqlite
                                 {:git/url "https://github.com/kotoba-lang/kotobase-storage-sqlite.git"
                                  :git/sha "d669666daf0cfa67db1b5a973f01720f2ec3fc4b"}}}

  ;; -d is repeated explicitly. cognitect.test-runner defaults to the single
  ;; directory "test", so adding test-kotobase to :extra-paths alone puts it
  ;; on the classpath and runs none of it — reporting the base suite's green
  ;; as if it covered the adapter too.
  :kotobase-test {:extra-paths ["test-kotobase"]
                  :main-opts ["-m" "cognitect.test-runner"
                              "-d" "test" "-d" "test-kotobase"]}

  ;; All four source roots. Naming only "src test" here lints the base
  ;; library and reports clean while never opening the adapter — the same
  ;; shape as the test runner defaulting to one directory.
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint"
                     "src" "test" "src-kotobase" "test-kotobase"
                     "--fail-level" "error"]}}}
